---
import "../styles/global.css";
import Music from "../components/icons/music.astro"
import { ClientRouter } from "astro:transitions";
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
    <title>Wedding-Card</title>
    <ClientRouter />
  </head>

  <body transition:animate="slide">
    <!-- Botón de música -->
    <div class="fixed bottom-4 right-4 z-50">
      <button
        id="music-toggle"
        class="border text-white bg-primary rounded-full p-3 shadow-lg hover:scale-110 transition duration-300"
        aria-label="Reproducir música"
      >
        <Music className="w-6 h-6 text-white" />
      </button>
    </div>

    <!-- Audio (¡marcado como persistente correctamente!) -->
    <audio
      id="bg-music"
      src="/music/music.mp3"
      preload="auto"
      loop
      transition:persist
    ></audio>

    <slot />

    <footer class="bg-primary text-secondary text-center py-6">
      <p class="text-sm">
        Desarrollado por:
        <a href="https://www.facebook.com/karlo.torres.846881/" target="_blank" class="underline hover:text-white">
          ktorres63
        </a>
        <br />
        Inspirado en:
        <a href="https://invitali.com/muestra-pasport/?n=2%20pases&m=Daniel%20Martinez" target="_blank" class="underline hover:text-white">
          Invitali
        </a>
      </p>
    </footer>
    
  </body>
</html>

<style is:global>
  @reference "../styles/global.css";

  html {
    @apply bg-background scroll-smooth font-baskerbille;
  }

  body {
    @apply h-full m-0 p-0;
    @apply bg-[url('/img/FondoMundo.webp')] bg-center bg-repeat;
  }
</style>
<!-- data-astro-rerun -->
<script is:inline >
  function setupAudioToggle() {
    const btn = document.getElementById("music-toggle");
    const audio = document.getElementById("bg-music");
    if (!btn || !audio) return;

    // El estado de reproducción se guarda globalmente
    if (window._bgMusicState === undefined) {
      window._bgMusicState = { playing: false };
    }

    btn.onclick = () => {
      if (!window._bgMusicState.playing) {
        audio.play().catch((e) => console.error("Error al reproducir:", e));
        window._bgMusicState.playing = true;
        btn.classList.add("bg-play");
        btn.classList.remove("bg-primary");
      } else {
        audio.pause();
        window._bgMusicState.playing = false;
        btn.classList.remove("bg-play");
        btn.classList.add("bg-primary");
      }
    };
  }

  document.addEventListener("astro:page-load", setupAudioToggle);
</script>
