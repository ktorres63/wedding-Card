---

import Layout from "../../layouts/Layout.astro";
import Guest from "../../components/Guest.astro";
import Hero from "../../components/Hero.astro";
import Parents from "../../components/Parents.astro";
import Compass from "../../components/Compass.astro";
import Countdown from "../../components/Countdown.astro";
import MapSuit from "../../components/MapSuit.astro";
import WorldTrip from "../../components/WorldTrip.astro";
import Itinerary from "../../components/Itinerary.astro";
import EngagedPhotos from "../../components/EngagedPhotos.astro";
import QrCode from "../../components/QrCode.astro";
import CheckIn from "../../components/CheckIn.astro";
import PartyPhotos from "../../components/PartyPhotos.astro";
import OnlyAdults from "../../components/OnlyAdults.astro";


const segments = Astro.params.params?.split("/") ?? [];
const nombre = decodeURIComponent(segments[0] ?? "Invitado");
const pases = decodeURIComponent(segments[1] ?? "1");

export const prerender = false;

---

<Layout title="Invitación">
  <section>
    <Hero />
    <Guest nombre={nombre} pases={pases} />
    <Parents />
    <Compass />  
    <Countdown />
    <MapSuit />
    <WorldTrip />
    <Itinerary/>
    <EngagedPhotos/>
    <QrCode/>
    <OnlyAdults/>
    <PartyPhotos/>
    <CheckIn/>

  </section>
</Layout>
<style></style>
