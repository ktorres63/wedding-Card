---
import WaveTop from "../components/icons/WaveTop.astro";
import WaveBottom from "../components/icons/WaveBottom.astro";
---

<section
  class="relative text-center pt-[80px] pb-[80px] bg-background text-white mt-8"
  id="guest-section"
>
  <!-- Ola superior -->
  <div class="absolute top-0 left-0 w-full leading-[0] text-primary">
    <WaveTop />
  </div>

  <!-- Contenido -->
  <div class="bg-primary pt-5">
    <p class="mb-5">
      El regalo es opcional, tu presencia obligatoria pero si deseas tener un
      detalle con nostros te dejamos nuestra cuenta bancaria y nuestro QR <span
        class="block font-bold">¿Te unes?</span
      >
    </p>

    <img src="/img/qr-sample.png" class="mx-auto p-5 border h-60" alt="qr" />
    <p class="mt-3">Cuenta BCP: 123456789</p>
    <p>CCI: 0024122345678907</p>
  </div>

  <!-- Ola inferior -->
  <div class="absolute bottom-0 left-0 w-full leading-[0] text-primary">
    <WaveBottom />
  </div>
</section>
